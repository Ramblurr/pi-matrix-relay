{:paths ["src" "resources"]
 :deps  {org.clojure/clojure               {:mvn/version "1.12.4"}
         party.donut/system                {:mvn/version "1.0.258"}
         http-kit/http-kit                 {:mvn/version "2.8.1"}
         metosin/reitit-ring               {:mvn/version "0.10.1"}
         ring/ring-core                    {:mvn/version "1.15.2"}
         com.cnuernber/charred             {:mvn/version "1.037"}
         missionary/missionary             {:mvn/version "b.47"}
         org.replikativ/datahike           {:mvn/version "0.8.1686"
                                            :exclusions  [org.clojure/clojurescript]}
         com.outskirtslabs/dirs            {:mvn/version "0.1.0"}
         com.outskirtslabs/datahike-sqlite {:git/url    "https://github.com/outskirtslabs/datahike-sqlite.git"
                                            :git/sha    "62172aa45c062c836db9c58f3223645a6a0058b6"
                                            :exclusions [org.suskalo/coffi andersmurphy/sqlite4clj]}
         andersmurphy/sqlite4clj           {:git/url    "https://github.com/andersmurphy/sqlite4clj"
                                            :git/sha    "2d1d8dc01d4a85b622e37dc8a6a84a48edd39fc7"
                                            :exclusions [org.suskalo/coffi]}
         com.outskirtslabs/trixnity-clj    {:git/url    "https://github.com/outskirtslabs/trixnity-clj.git"
                                            :git/sha    "b6b26d8a7a7da6e3e9bf2732253cac326f0ac6db"
                                            :exclusions [org.suskalo/coffi andersmurphy/sqlite4clj]}
         org.suskalo/coffi                 {:git/url "https://github.com/ramblurr/coffi"
                                            :git/sha "9b05e268b915b1992bfd4175cb7c8c7c45d8973a"}}
 :aliases
 {:run  {:jvm-opts  ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "pi-matrix-relay.broker.main"]}
  :test {:extra-paths ["test"]
         :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/url "https://github.com/cognitect-labs/test-runner.git"
                                                             :git/tag "v0.5.1"
                                                             :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  :dev  {:extra-paths ["dev" "test"]
         :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
         :extra-deps  {nrepl/nrepl                              {:mvn/version "1.4.0"}
                       cider/cider-nrepl                        {:mvn/version "0.62.2"}
                       dev.weavejester/hashp                    {:mvn/version "0.5.1"}
                       io.github.tonsky/clj-reload              {:mvn/version "1.0.0"}
                       djblue/portal                            {:mvn/version "0.64.1"}
                       com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.7.0"}}
         :main-opts   ["-m" "nrepl.cmdline"
                       "--middleware" "[cider.nrepl/cider-middleware]"
                       "--port" "0"]}

  :neil {:project {:name        com.outskirtslabs/TODO
                   :url         "https://example.com/TODO"
                   :license     {:id "TODO"}
                   :description ""
                   :version     "0.0.TODO"}}}}
